# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
VITE_DEFAULT_DATA_MODE=SIMULATION

# Backend
QOSENSE_ENV=development
QOSENSE_DATA_MODE=SIMULATION
QOSENSE_DATABASE_URL=sqlite:///./qosense.db
QOSENSE_ALLOWED_ORIGINS=http://localhost:5173
QOSENSE_LAB_AGENT_URL=
QOSENSE_LAB_AGENT_TOKEN=
QOSENSE_ENABLE_LIVE_ENFORCEMENT=false

# Experiment safety bounds (examples; validate before use)
QOSENSE_MAX_SCENARIO_DURATION_SECONDS=600
QOSENSE_MAX_INTENT_DURATION_SECONDS=3600
QOSENSE_MAX_POLICY_RATE_STEP_PERCENT=20
QOSENSE_REQUIRE_POLICY_READBACK=true
